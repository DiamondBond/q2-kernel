choice
	prompt "device tree select for X2000 X2100 boards"
	depends on SOC_X2000 || SOC_X2100

config DT_X2000_MODULE_BASE
       bool "x2000 module base"

config DT_HALLEY5_V20
       bool "x2000 halley5_v20"

config DT_HALLEY5_V30
       bool "x2000 halley5_v30"

config DT_ZEBRA
       bool "x2000 zebra"

config DT_KALE_V10
       bool "x2100 kale_v10"

config DT_KALE_V12
       bool "x2100 kale_v12"

config DT_WICOM_X2000_LINPHONE_OUTDOOR
       bool "wicom x2000 linphone_outdoor"

config DT_WICOM_X2000_LINPHONE_INDOOR
       bool "wicom x2000 linphone_indoor"

config DT_X2100_KALE_V12
       bool "x2100_kale_v12 board"

config DT_X2000_HALLEY5_V30
       bool "x2000_halley5_v30 board"

endchoice

config DT_X2000_MODULE_BASE_DTS_FILE
	string "dts file for X2000 module driver"
	depends on DT_X2000_MODULE_BASE
	default "x2000_module_base.dts"
	help
		the dts file location is arch/mips/boot/dts/ingenic/
