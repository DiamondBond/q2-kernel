choice
	prompt "device tree select for X2500 boards"
	default DT_HIPPO_V10
	depends on SOC_X2500

config DT_X2500_MODULE_BASE
	bool "x2500 module base"
config DT_STAGE_X2500_MODULE_BASE
	bool "x2500 module base (dts-stage)"
config DT_GANDER_V10
	bool "x2500 gander_v10"
config DT_DARWIN_V14
	bool "x2500 darwin_v14"
config DT_HIPPO_V10
	bool "x2500 hippo_v10"
config DT_HIPPO_V12
	bool "x2500 hippo_v12"
config DT_X2500_HIPPO_V12
	bool "x2500_hippo_v12 board"

endchoice

config DT_X2500_MODULE_BASE_DTS_FILE
	string "dts file for X2500 module driver"
	depends on DT_X2500_MODULE_BASE
	default "x2500_module_base.dts"
	help
		the dts file location is arch/mips/boot/dts/ingenic/

config DT_X2500_MODULE_BASE_DTS_STAGE_FILE
	string "dts-stage file for X2500 module driver"
	depends on DT_STAGE_X2500_MODULE_BASE
	default "x2500_module_base.dts"
	help
		the dts file location is module_drivers/dts-stage/x2500/
