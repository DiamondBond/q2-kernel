	  If unsure, say N.

if TOUCHSCREEN_GT9XX

config TOUCHSCREEN_GT9XX_DIRECTORY
    string "gt ts directory name"
    default "gt9xx_touch"
    depends on TOUCHSCREEN_GT9XX

endif

