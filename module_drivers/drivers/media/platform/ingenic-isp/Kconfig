config VIC_DMA_ROUTE
	bool "vic dma out route enable"
	default y
	depends on VIDEO_INGENIC_ISP

config ISP_MSCALER_DMA_ROUTE
	bool "isp mscaler dma out route enable"
	default y
	depends on VIDEO_INGENIC_ISP

menuconfig DUMP_FEATURE
	bool "Enable csi/vic/isp/mscaler dump feature"
	default y
	depends on VIDEO_INGENIC_ISP
	help
		Enable this option to generate sysfs attributes for csi/vic/isp/mscaler dump.

config CSI_DUMP
	bool "Enable csi dump feature"
	default y
	depends on DUMP_FEATURE
	help
		Enable this option to generate sysfs attributes for csi dump.

config VIC_DUMP
	bool "Enable vic dump feature"
	default y
	depends on DUMP_FEATURE
	help
		Enable this option to generate sysfs attributes for vic dump.

config ISP_DUMP
	bool "Enable isp dump feature"
	default y
	depends on DUMP_FEATURE
	depends on ISP_MSCALER_DMA_ROUTE
	help
		Enable this option to generate sysfs attributes for isp dump.

config MSCA_DUMP
	bool "Enable mscaler dump feature"
	default y
	depends on DUMP_FEATURE
	depends on ISP_MSCALER_DMA_ROUTE
	help
		Enable this option to generate sysfs attributes for mscaler dump.

