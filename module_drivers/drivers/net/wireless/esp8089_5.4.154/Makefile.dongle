# linux_sdio

#ifneq ($(KERNELRELEASE),)
# kbuild part of makefile
ARCH := arm
CROSS_COMPILE := /cold/hklt/patched/dangle_A10S_0918/lichee/buildroot/output/external-toolchain/bin/arm-none-linux-gnueabi-
KSRC := /cold/hklt/patched/dangle_A10S_0918/lichee/linux-3.0/
MODPATH := $(shell pwd)
DRIVER_NAME := esp8089

EXTRA_CFLAGS += -DDEBUG -DSIP_DEBUG -DFAST_TX_STATUS -DANDROID -DKERNEL_IV_WAR -DSUNXIMMC -DRX_SENDUP_SYNC -DDEBUGFS -DHAS_FW -DESP_ANDROID_LOGGER -DSCAN_PORT=1 -DTEST_MODE
obj-m := $(DRIVER_NAME).o
$(DRIVER_NAME)-y += esp_debug.o
$(DRIVER_NAME)-y += sdio_sif_esp.o
$(DRIVER_NAME)-y += esp_android.o
$(DRIVER_NAME)-y += esp_main.o
$(DRIVER_NAME)-y += esp_sip.o
$(DRIVER_NAME)-y += esp_ctrl.o
$(DRIVER_NAME)-y += esp_mac80211.o
$(DRIVER_NAME)-y += esp_debug.o
$(DRIVER_NAME)-y += esp_utils.o
$(DRIVER_NAME)-y += esp_pm.o
$(DRIVER_NAME)-y += testmode.o

$(DRIVER_NAME):
	rm -f esp_version.h         
	hg identify | grep -o "^\w*" > esp_version.h 
	sed -i  's/^\w*/#define DRIVER_VER 0x&ll/' esp_version.h
	$(MAKE) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) -C $(KSRC) M=$(MODPATH) modules

.PHONE:clean
clean:
	$(MAKE) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) -C $(KSRC) M=$(MODPATH) clean
#else
#KDIR ?= /lib/modules/`uname -r`/build
##KDIR ?= /home/espressif/src/sdio/cleanup

